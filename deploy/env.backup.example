# Copy to .env.backup ON THE SERVER (gitignored), chmod 600. Read only by
# deploy/backup.sh, never by the app containers. See
# docs/deployment-digitalocean.md, "Backups to Cloudflare R2".
BACKUP_BUCKET=phastos-backups
BACKUP_S3_ENDPOINT=https://CHANGE_ME.r2.cloudflarestorage.com
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
