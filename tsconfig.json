{
  "compilerOptions": {
    "ignoreDeprecations": "5.0",
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": false,
    "esModuleInterop": true,
    "paths": {
      "@lib/domain": ["./libs/domain/src"],
      "@lib/domain/*": ["./libs/domain/src/*"],
      "@lib/kafka-contracts": ["./libs/kafka-contracts/src"],
      "@lib/kafka-contracts/*": ["./libs/kafka-contracts/src/*"],
      "@lib/redis-scripts": ["./libs/redis-scripts/src"],
      "@lib/redis-scripts/*": ["./libs/redis-scripts/src/*"],
      "@lib/database": ["./libs/database/src"],
      "@lib/database/*": ["./libs/database/src/*"],
      "@lib/rabbitmq-contracts": ["./libs/rabbitmq-contracts/src"],
      "@lib/rabbitmq-contracts/*": ["./libs/rabbitmq-contracts/src/*"],
      "@lib/common": ["./libs/common/src"],
      "@lib/common/*": ["./libs/common/src/*"],
      "@app/api/*": ["./apps/api/src/*"],
      "@app/notification-worker/*": ["./apps/notification-worker/src/*"],
      "@app/event-consumer/*": ["./apps/event-consumer/src/*"]
    }
  }
}
