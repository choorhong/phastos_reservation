{
  "name": "phastos-reservation",
  "version": "0.1.0",
  "private": true,
  "description": "Slot-booking / reservation system (NestJS monorepo: api, notification-worker, event-consumer)",
  "scripts": {
    "build": "nest build",
    "build:all": "nest build api && nest build notification-worker && nest build event-consumer",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:api": "nest start api --watch",
    "start:notification-worker": "nest start notification-worker --watch",
    "start:event-consumer": "nest start event-consumer --watch",
    "test": "jest",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^4.0.0",
    "@nestjs/typeorm": "^10.0.0",
    "amqp-connection-manager": "^4.1.0",
    "amqplib": "^0.10.0",
    "dotenv": "^16.4.0",
    "ioredis": "^5.3.0",
    "kafkajs": "^2.2.0",
    "nestjs-cls": "^4.0.0",
    "nestjs-pino": "^4.0.0",
    "pg": "^8.11.0",
    "pino-http": "^10.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/amqplib": "^0.10.0",
    "@types/express": "^4.17.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "jest": "^29.0.0",
    "pino-pretty": "^11.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-loader": "^9.5.0",
    "ts-node": "^10.9.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0"
  }
}
