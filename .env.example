# Postgres (see docker-compose.yml "postgres" service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=phastos
POSTGRES_PASSWORD=phastos
POSTGRES_DB=phastos_reservation

# Redis (see docker-compose.yml "redis" service)
REDIS_HOST=localhost
REDIS_PORT=6379
HOLD_TTL_SECONDS=300
HOLD_REAPER_SWEEP_INTERVAL_MS=30000

# RabbitMQ (see docker-compose.yml "rabbitmq" service)
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=phastos
RABBITMQ_PASSWORD=phastos
NOTIFICATION_MAX_RETRIES=3

# Reminder sweep (notification-worker): DB scheduler sweep -> RabbitMQ
# (PLAN.md "Decisions" #2)
REMINDER_LEAD_MINUTES=60
REMINDER_SWEEP_INTERVAL_MS=60000

# Slot generation (apps/api/src/modules/slots): weekday slots are created for
# every location, 10:00-18:00 in the location's own timezone, in 2h blocks of
# 3 spots each, for today plus the next 30 days. The job re-checks every
# 6 hours (21600000 ms), so a restart or missed run self-heals.
SLOT_OPEN_HOUR=10
SLOT_CLOSE_HOUR=18
SLOT_DURATION_HOURS=2
SLOT_CAPACITY=3
SLOT_WINDOW_DAYS=30
SLOT_GENERATION_INTERVAL_MS=21600000

# Kafka (see docker-compose.yml "kafka" service; kafka-ui on :8080)
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=phastos-reservation
# 1 for a single local broker; PLAN.md calls for 3 in non-local envs.
KAFKA_TOPIC_REPLICATION_FACTOR=1
EVENT_CONSUMER_GROUP_ID=event-consumer

# Auth (apps/api/src/modules/auth) -- JWT_SECRET must be overridden with a
# real secret outside local dev. ADMIN_EMAIL/ADMIN_PASSWORD bootstrap the
# one admin account on api boot if no user with that email exists yet
# (AdminBootstrapService); leave unset to skip bootstrapping.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=1h
ADMIN_EMAIL=admin@phastos.local
ADMIN_PASSWORD=phastos-admin

# apps
API_PORT=3000
NOTIFICATION_WORKER_PORT=3001
EVENT_CONSUMER_PORT=3002

NODE_ENV=development
