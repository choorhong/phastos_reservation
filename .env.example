# Postgres (see docker-compose.yml "postgres" service)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=phastos
POSTGRES_PASSWORD=phastos
POSTGRES_DB=phastos_reservation

# Redis (see docker-compose.yml "redis" service)
REDIS_HOST=localhost
REDIS_PORT=6379
HOLD_TTL_SECONDS=300
HOLD_REAPER_SWEEP_INTERVAL_MS=30000

# apps
API_PORT=3000
NOTIFICATION_WORKER_PORT=3001
EVENT_CONSUMER_PORT=3002

NODE_ENV=development
