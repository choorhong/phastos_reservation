{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api/src",
  "monorepo": true,
  "root": "apps/api",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/api/tsconfig.app.json",
    "plugins": [{ "name": "@nestjs/swagger/plugin", "options": { "introspectComments": true } }]
  },
  "projects": {
    "api": {
      "type": "application",
      "root": "apps/api",
      "entryFile": "main",
      "sourceRoot": "apps/api/src",
      "compilerOptions": {
        "tsConfigPath": "apps/api/tsconfig.app.json"
      }
    },
    "notification-worker": {
      "type": "application",
      "root": "apps/notification-worker",
      "entryFile": "main",
      "sourceRoot": "apps/notification-worker/src",
      "compilerOptions": {
        "tsConfigPath": "apps/notification-worker/tsconfig.app.json"
      }
    },
    "event-consumer": {
      "type": "application",
      "root": "apps/event-consumer",
      "entryFile": "main",
      "sourceRoot": "apps/event-consumer/src",
      "compilerOptions": {
        "tsConfigPath": "apps/event-consumer/tsconfig.app.json"
      }
    },
    "domain": {
      "type": "library",
      "root": "libs/domain",
      "entryFile": "index",
      "sourceRoot": "libs/domain/src",
      "compilerOptions": {
        "tsConfigPath": "libs/domain/tsconfig.lib.json"
      }
    },
    "kafka-contracts": {
      "type": "library",
      "root": "libs/kafka-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/kafka-contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/kafka-contracts/tsconfig.lib.json"
      }
    },
    "redis-scripts": {
      "type": "library",
      "root": "libs/redis-scripts",
      "entryFile": "index",
      "sourceRoot": "libs/redis-scripts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/redis-scripts/tsconfig.lib.json"
      }
    },
    "database": {
      "type": "library",
      "root": "libs/database",
      "entryFile": "index",
      "sourceRoot": "libs/database/src",
      "compilerOptions": {
        "tsConfigPath": "libs/database/tsconfig.lib.json"
      }
    },
    "rabbitmq-contracts": {
      "type": "library",
      "root": "libs/rabbitmq-contracts",
      "entryFile": "index",
      "sourceRoot": "libs/rabbitmq-contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/rabbitmq-contracts/tsconfig.lib.json"
      }
    },
    "common": {
      "type": "library",
      "root": "libs/common",
      "entryFile": "index",
      "sourceRoot": "libs/common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/common/tsconfig.lib.json"
      }
    },
    "config": {
      "type": "library",
      "root": "libs/config",
      "entryFile": "index",
      "sourceRoot": "libs/config/src",
      "compilerOptions": {
        "tsConfigPath": "libs/config/tsconfig.lib.json"
      }
    },
    "time": {
      "type": "library",
      "root": "libs/time",
      "entryFile": "index",
      "sourceRoot": "libs/time/src",
      "compilerOptions": {
        "tsConfigPath": "libs/time/tsconfig.lib.json"
      }
    }
  }
}
