# Production settings for docker-compose.prod.yml (see docs/deployment.md).
# Copy to .env.production ON THE SERVER ONLY (it is gitignored) and replace
# every CHANGE_ME. Generate secrets with:  openssl rand -base64 32
# (or, for passwords used in URLs:      openssl rand -hex 24)

# Postgres -- POSTGRES_HOST is the compose service name, not localhost.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=phastos
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=phastos_reservation

# Redis (only reachable on the compose network, so no password)
REDIS_HOST=redis
REDIS_PORT=6379
HOLD_TTL_SECONDS=300
HOLD_REAPER_SWEEP_INTERVAL_MS=30000

# RabbitMQ -- also used by the rabbitmq container to create its user.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=phastos
RABBITMQ_PASSWORD=CHANGE_ME
NOTIFICATION_MAX_RETRIES=3

# Reminder sweep (notification-worker)
REMINDER_LEAD_MINUTES=60
REMINDER_SWEEP_INTERVAL_MS=60000

# Email via Resend. EMAIL_FROM must use a domain verified in Resend.
# Do NOT set EMAIL_REDIRECT_TO in production.
RESEND_API_KEY=CHANGE_ME
EMAIL_FROM=Phastos <no-reply@CHANGE_ME>

# Slot generation
SLOT_OPEN_HOUR=10
SLOT_CLOSE_HOUR=18
SLOT_DURATION_HOURS=2
SLOT_CAPACITY=3
SLOT_WINDOW_DAYS=30
SLOT_GENERATION_INTERVAL_MS=21600000

# Kafka -- single broker, so replication factor 1. KAFKA_CLUSTER_ID is
# set once and never changed (the broker's data is tied to it). Generate one with:
#   docker run --rm confluentinc/cp-kafka:7.6.0 kafka-storage random-uuid
KAFKA_BROKERS=kafka:9092
KAFKA_CLIENT_ID=phastos-reservation
KAFKA_TOPIC_REPLICATION_FACTOR=1
EVENT_CONSUMER_GROUP_ID=event-consumer
KAFKA_CLUSTER_ID=CHANGE_ME

# Auth -- JWT_SECRET must be a long random secret.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=1h
# Bootstraps the one admin account on first boot. Remove both lines once
# the admin exists, so the password doesn't sit on the server.
ADMIN_EMAIL=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME

# apps
API_PORT=3000
NOTIFICATION_WORKER_PORT=3001
EVENT_CONSUMER_PORT=3002

# Only for the optional caddy service (--profile proxy): the public domain
# whose DNS A record points at this server.
API_DOMAIN=api.CHANGE_ME

NODE_ENV=production
